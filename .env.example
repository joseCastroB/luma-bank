# =============================================================================
# Luma Bank - plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` (que esta ignorado por Git) y ajusta los valores.
#   cp .env.example .env
# NUNCA subas `.env` ni secretos reales al repositorio.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Modulo de settings. dev = local (DEBUG on). prod = despliegue (DEBUG off).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Clave secreta. Genera una nueva para prod:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Solo prod: origenes de confianza para CSRF (coma-separados), p.ej. https://luma.pe
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Validacion de identidad (RENIEC via LionAPI) --------------------------
# production = llama a LionAPI y cachea por DNI (creditos limitados: 90/mes gratis).
# mock       = NO llama a LionAPI; devuelve datos simulados. SOLO desarrollo/tests.
# Si esta variable NO se define, el sistema se comporta como 'production' (fail-safe).
# PROHIBIDO usar 'mock' en produccion (lo bloquea CI y config/settings/prod.py).
DNI_VALIDATION_MODE=mock
LIONAPI_KEY=
LIONAPI_BASE_URL=https://www.softwarelion.pe/api/lion-api/v1
LIONAPI_CACHE_TTL_SECONDS=2592000

# --- Base de datos (PostgreSQL 18) ---------------------------------------
# Usada por Django. El host es el nombre del servicio en docker-compose.
DATABASE_URL=postgres://luma:luma@postgres:5432/luma
# Usadas por el contenedor `postgres` para inicializar el cluster.
POSTGRES_USER=luma
POSTGRES_PASSWORD=luma
POSTGRES_DB=luma

# --- Cache / sesiones (Valkey 8) ---------------------------------------
REDIS_URL=redis://valkey:6379/0

# --- Almacenamiento de objetos (MinIO / S3) --------------------------------
# Guarda los embeddings faciales CIFRADOS (AES-256). Nunca fotos ni el
# embedding en claro; en PostgreSQL solo queda la referencia al objeto.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=luma-minio-admin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET_EMBEDDINGS=luma-face-embeddings
MINIO_USE_TLS=false
# Clave AES-256 para cifrar embeddings y el secreto TOTP en reposo.
# Acepta 32 bytes en base64-urlsafe (44 chars) o hex (64 chars).
# El valor de abajo es SOLO para desarrollo; genera otro para produccion:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FACE_EMBEDDING_ENCRYPTION_KEY=y8XhRPOsCQuGHBRRebpItBxxtncpbyTmCQ7Bnd-t77M=

# --- Reconocimiento facial ---------------------------------------------
# Umbral de coincidencia (distancia). Menor = mas estricto. Ajustar al modelo.
FACE_MATCH_THRESHOLD=0.6

# --- Segundo factor (TOTP) -------------------------------------------
TOTP_ISSUER=Luma Bank

# --- Politica de intentos de login (HU03) --------------------------
LOGIN_MAX_FACIAL_ATTEMPTS=2
LOGIN_MAX_TOTAL_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# --- Frontend --------------------------------------------------------------
# URL publica de la API (se hornea en el bundle de Vite en build).
VITE_API_URL=http://localhost:8000
# URL del frontend (para CORS del backend).
FRONTEND_URL=http://localhost:5173
# Puerto del frontend servido por Nginx (perfil base/produccion).
FRONTEND_PORT=8080
